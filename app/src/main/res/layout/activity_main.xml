<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="#2E7CB8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="5dp">

    <ImageView
        android:id="@+id/pytanieImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/lake"
        android:padding="5dp"/>

    <TextView
        android:id="@+id/pytanieTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jak nazywa sie ta mapa?"
        android:textSize="30sp"
        android:textColor="@color/white"/>

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="left">

            <RadioButton
                android:text="Rialto"
                android:id="@+id/odpowiedzRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>

            <RadioButton
                android:text="Lake"
                android:id="@+id/odpowiedz2Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>

            <RadioButton
                android:text="Safehouse"
                android:id="@+id/odpowiedz3Radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"/>

        </RadioGroup>

        <Button
            android:id="@+id/dalejButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DALEJ"
            />

    </LinearLayout>

</LinearLayout>